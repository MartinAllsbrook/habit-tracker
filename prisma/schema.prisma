generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  habits        Habit[]
  goals         Goal[]
}

enum HabitType {
  BOOLEAN
  VALUE
  TALLY
}

model Habit {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  type        HabitType     @default(BOOLEAN)
  unit        String?       // e.g., "kilometers", "minutes", "steps" (null for boolean/tally habits)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     HabitEntry[]
  goals       Goal[]        @relation(name: "GoalHabits")
}

// Unified model for all habit types
model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  timestamp DateTime @default(now()) // Full timestamp (for VALUE/TALLY, same as date start for BOOLEAN)
  value     Float?   // Required for VALUE, null for TALLY and BOOLEAN
  notes     String?
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model Goal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits    Habit[]   @relation(name: "GoalHabits")
  target    Int       // e.g., 5 (number of days)
  period    String    // e.g., "week", "month"
  name      String?   // e.g., "Walk, run, or climb 5 days this week"
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
