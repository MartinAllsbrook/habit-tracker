{
    "nodeModulesDir": "auto",
    "unstable": [
        "unsafe-proto",
        "sloppy-imports"
    ],
    "fmt": {
        "indentWidth": 4
    },
    "compilerOptions": {
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "strict": true,
        "jsx": "preserve",
        "module": "esnext",
        "moduleResolution": "bundler"
    },
    "tasks": {
        "dev": "deno run -A --unstable-detect-cjs npm:next@latest dev",
        "build": "deno run -A --unstable-detect-cjs npm:next@latest build",
        "start": "deno run -A --unstable-detect-cjs npm:next@latest start"
    },
    "imports": {
        "@/": "./src/"
    }
}
